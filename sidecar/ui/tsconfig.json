{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client", "bun"],
    "baseUrl": ".",
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "vite.config.ts",
    "playwright.config.ts",
    "strip-bundle.ts"
  ]
}
